+#[cfg(test)]
+mod read_link_tests {
+    use super::win32_path;
+    use std::ffi::OsStr;
+    use std::os::windows::ffi::OsStrExt;
+    use std::path::PathBuf;
+
+    fn after_nt_prefix(path: &str) -> PathBuf {
+        let wide: Vec<u16> = OsStr::new(path).encode_wide().collect();
+        win32_path(&wide)
+    }
+
+    #[test]
+    fn a_drive_target_keeps_its_drive() {
+        assert_eq!(
+            after_nt_prefix(r"C:\Users\dev\pkg"),
+            PathBuf::from(r"C:\Users\dev\pkg")
+        );
+        assert_eq!(after_nt_prefix(r"C:\"), PathBuf::from(r"C:\"));
+    }
+
+    #[test]
+    fn a_network_target_keeps_its_server_and_share() {
+        for target in [r"UNC\server\share\pkg", r"unc\server\share\pkg"] {
+            let path = after_nt_prefix(target);
+            assert_eq!(path, PathBuf::from(r"\\server\share\pkg"), "{target}");
+            assert!(path.is_absolute(), "{target}");
+        }
+    }
+
+    #[test]
+    fn a_target_win32_would_change_stays_extended() {
+        for target in [
+            r"UNC\server\share\pkg.",
+            r"UNC\server\share\pkg ",
+            r"C:\Users\dev\pkg.",
+            r"C:",
+        ] {
+            let path = after_nt_prefix(target);
+            assert_eq!(path, PathBuf::from(format!(r"\\?\{target}")), "{target}");
+            assert!(path.is_absolute(), "{target}");
+        }
+    }
+
+    #[test]
+    fn any_other_target_stays_extended_and_absolute() {
+        for target in [
+            r"Volume{01234567-89ab-cdef-0123-456789abcdef}\pkg",
+            r"UNCserver\share",
+            r"GLOBALROOT\Device\HarddiskVolume3\pkg",
+        ] {
+            let path = after_nt_prefix(target);
+            assert_eq!(path, PathBuf::from(format!(r"\\?\{target}")), "{target}");
+            assert!(path.is_absolute(), "{target}");
+        }
     }
 }
