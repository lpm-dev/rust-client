    "probe_source": "use std::{path::Path, time::Instant, fs::File, io::BufReader};\n#[global_allocator]\nstatic ALLOCATOR: mimalloc::MiMalloc = mimalloc::MiMalloc;\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let start = Instant::now();\n    let file = BufReader::new(File::open(&args[1]).unwrap());\n    let files = match args[3].as_str() {\n        \"pipelined\" => lpm_extractor::extract_tarball_from_reader_pipelined_digests(file, Path::new(&args[2]), || {}),\n        \"stream\" => lpm_extractor::extract_tarball_from_reader_streaming_digests(file, Path::new(&args[2])),\n        \"hybrid\" => lpm_extractor::extract_tarball_from_reader_hybrid_digests(file, Path::new(&args[2])),\n        \"buffered\" => lpm_extractor::extract_tarball_from_reader_with_entry_digests(file, Path::new(&args[2]), |_, _| false, |_| {}),\n        _ => panic!(\"unknown strategy\"),\n    }.unwrap();\n    println!(\"{} {}\", start.elapsed().as_micros(), files.len());\n}\n",
    "micro_script": "from pathlib import Path\nimport subprocess,tempfile,json,itertools,os,re,statistics,hashlib,shutil\nr=Path('<scratch>');out=r/'final-micro';out.mkdir(exist_ok=False);rows=[]\nfor round in range(7):\n for variant in list(itertools.permutations(['baseline','serial','pipelined']))[(round-1)%6] if round else ['baseline','serial','pipelined']:\n  with tempfile.TemporaryDirectory(prefix='extract-',dir=out) as tmp:\n   dest=Path(tmp)\n   for i in range(4):dest=dest/('fixed-prefix-'+str(i)+'x'*22)\n   dest.mkdir(parents=True)\n   p=subprocess.run(['/usr/bin/time','-l',str(r/('probe-baseline' if variant=='baseline' else 'probe-final')),str(r/'next-16.3.6.tgz'),str(dest),('pipelined' if variant=='pipelined' else 'stream')],capture_output=True,text=True)\n   assert p.returncode==0,p.stderr\n   (out/f'{round}-{variant}.stderr').write_text(p.stderr)\n   us,count=map(int,p.stdout.split());rss=int(re.search(r'(\\d+)\\s+maximum resident set size',p.stderr).group(1))\n   rows.append(dict(round=round,counted=round>0,variant=variant,elapsed_us=us,files=count,max_rss_bytes=rss))\n   (out/'rows.json').write_text(json.dumps(rows,indent=2)+'\\n')\n   if round==0:\n    entries={str(p.relative_to(dest)):{'size':p.stat().st_size,'mode':p.stat().st_mode&0o777,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in dest.rglob('*') if p.is_file()}\n    (out/(variant+'-manifest.json')).write_text(json.dumps(entries,sort_keys=True))\n print('micro round',round,flush=True)\nassert json.loads((out/'baseline-manifest.json').read_text())==json.loads((out/'serial-manifest.json').read_text())==json.loads((out/'pipelined-manifest.json').read_text())\nprint(json.dumps({v:{k:statistics.median(x[k] for x in rows if x['counted'] and x['variant']==v) for k in ['elapsed_us','max_rss_bytes']} for v in ['baseline','serial','pipelined']},indent=2))\n",
    "retention_patch": "--- a/bench/scripts/run-install-readiness.mjs\n+++ b/bench/scripts/run-install-readiness.mjs\n@@ -6,7 +6,7 @@\n import { spawnSync } from 'node:child_process';\n import { fileURLToPath } from 'node:url';\n \n-const repoRoot = path.resolve(fileURLToPath(new URL('../..', import.meta.url)));\n+const repoRoot = process.cwd();\n \n const BUILTIN_FIXTURES = new Map([\n   [\n@@ -443,6 +443,48 @@\n       }\n     }\n   } finally {\n+    for (const filename of LOCKFILES) {\n+      const source = path.join(projectDir, filename);\n+      if (fs.existsSync(source)) fs.copyFileSync(source, path.join(runDir, filename));\n+    }\n+    const packageDirs = (nm) => {\n+      if (!fs.existsSync(nm)) return [];\n+      return fs.readdirSync(nm).filter(x => !x.startsWith('.')).flatMap(x => {\n+        const p = path.join(nm, x);\n+        return x.startsWith('@') && fs.statSync(p).isDirectory()\n+          ? fs.readdirSync(p).map(y => path.join(p, y)) : [p];\n+      });\n+    };\n+    let roots = [];\n+    if (spec.manager === 'bun') {\n+      const pending = [path.join(projectDir, 'node_modules')];\n+      const seen = new Set();\n+      while (pending.length) {\n+        const nm = pending.pop();\n+        if (seen.has(nm)) continue;\n+        seen.add(nm);\n+        for (const pkg of packageDirs(nm)) {\n+          roots.push(pkg);\n+          const nested = path.join(pkg, 'node_modules');\n+          if (fs.existsSync(nested)) pending.push(nested);\n+        }\n+      }\n+    } else {\n+      const links = path.join(lpmHome, 'store/v2/links');\n+      if (fs.existsSync(links)) {\n+        for (const entry of fs.readdirSync(links)) {\n+          roots.push(...packageDirs(path.join(links, entry, 'node_modules'))\n+            .filter(p => !fs.lstatSync(p).isSymbolicLink()));\n+        }\n+      }\n+    }\n+    const installed = roots.flatMap(pkg => {\n+      const manifest = path.join(pkg, 'package.json');\n+      if (!fs.existsSync(manifest)) return [];\n+      const p = JSON.parse(fs.readFileSync(manifest, 'utf8'));\n+      return p.name && p.version ? [`${p.name}@${p.version}`] : [];\n+    });\n+    fs.writeFileSync(path.join(runDir, 'selected-packages.json'), JSON.stringify([...new Set(installed)].sort()) + '\\n');\n     if (!keepProjects && !(keepFailedProjects && rowsForSpec.some(runFailed))) {\n       removeTree(tmpRoot);\n     }\n"
