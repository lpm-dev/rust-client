      "id": "RUNTIME-01",
      "source": "async_runtime_scheduling",
      "category": "correctness",
      "location": "crates/lpm-runtime/src/effective.rs:node_version_on_path",
      "claim": "Unix selects Node from script PATH but executes it with inherited PATH; helper-based shims can report incorrect/unavailable version.",
      "evidence": "Primary reproduced None instead of Some(\"22.0.0\") before the fix. Supplying the child PATH passes the regression. Runtime targeted suite: 128 tests, crate build, and all-target Clippy passed. Independent final review reported no new defect.",
      "disposition": "Verified",
      "coverage": "explicit_path_node_shim_resolves_helpers_from_the_supplied_path",
      "commit": "352eb733077e043536e65f69ce176a9d4ffed139",
      "pr_status": "Ready for review; publication pending"
    },
    {
      "id": "RUNTIME-02",
      "source": "async_runtime_scheduling",
      "category": "performance",
      "location": "crates/lpm-common/src/process_output.rs:output_capped",
      "claim": "Fixed2ms polling adds detection latency to version probes.",
      "evidence": "Repeated 2 ms sleeps overlap necessary child runtime. No completion-detection measurement attributes removable cost or tail delay. Existing no-op traces isolate no polling cost; changing process-tree handling without a measured benefit is unjustified.",
      "disposition": "Rejected",
      "coverage": null,
      "commit": null,
      "pr_status": "Ready for review; publication pending"
    },
    {
      "id": "RUNTIME-03",
      "source": "async_runtime_scheduling follow-up review",
      "category": "correctness",
      "location": "crates/lpm-runtime/src/effective.rs:PathNodeVersionCache::resolve",
      "claim": "Cache identity omits supplied PATH; unchanged helper-based shim can reuse another search path version or failure.",
      "evidence": "Primary proved both regressions before changing cache identity: cached 18.0.0 survived a helper PATH change, and cached None survived adding a helper directory. Both pass with the exact supplied PATH in the non-managed cache context. Runtime targeted suite: 128 tests, crate build, and all-target Clippy passed.",
      "disposition": "Verified",
      "coverage": "node_version_cache_reprobes_when_helper_search_path_changes; node_version_cache_reprobes_a_missing_helper_after_path_changes",
      "commit": "352eb733077e043536e65f69ce176a9d4ffed139",
      "pr_status": "Ready for review; publication pending"
    }
  ],
