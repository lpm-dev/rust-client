      "expect": {
        "result": "planned",
        "writes": {
          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"development\":{\"set\":{\"API_URL\":\"http://localhost:5000\",\"EMPTY\":\"\"},\"unset\":[\"SENTRY_DSN\"]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": false,
        "effects": [
          {
            "kind": "key",
            "environment": "development",
            "key": "API_URL",
            "previous": "set",
            "changed": true
          },
          {
            "kind": "key",
            "environment": "development",
            "key": "EMPTY",
            "previous": "none",
            "changed": true
          },
          {
            "kind": "key",
            "environment": "development",
            "key": "SENTRY_DSN",
            "previous": "none",
            "changed": true
          }
        ]
      }
    },
