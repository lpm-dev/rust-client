{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "the first override asks for the service's names",
      "vaultId": "proj",
      "marker": null,
      "record": null,
      "names": null,
      "edits": [
        {
          "action": "set",
          "environment": "development",
          "key": "API_URL",
          "value": "http://localhost:4000"
        }
      ],
      "expect": {
        "result": "needsNames"
      }
    },
    {
      "name": "the first override creates the record and adds the feature",
      "vaultId": "proj",
      "marker": null,
      "record": null,
      "names": [],
      "edits": [
        {
          "action": "set",
          "environment": "development",
          "key": "API_URL",
          "value": "http://localhost:4000"
        }
      ],
      "expect": {
        "result": "planned",
        "writes": {
          "__vault_features_v1__:cHJvag": "{\"schemaVersion\":1,\"vaultId\":\"proj\",\"state\":\"active\",\"features\":{\"overrides\":{\"version\":2,\"ifUnsupported\":\"refuse\",\"kinds\":[\"overrides\"],\"state\":\"active\"}}}",
          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"development\":{\"set\":{\"API_URL\":\"http://localhost:4000\"},\"unset\":[]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": true,
        "effects": [
          {
            "kind": "key",
            "environment": "development",
            "key": "API_URL",
            "previous": "none",
            "changed": true
          }
        ]
      }
    },
