          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"development\":{\"set\":{},\"unset\":[\"SENTRY_DSN\"]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": true,
        "effects": [
          {
            "kind": "key",
            "environment": "development",
            "key": "SENTRY_DSN",
            "previous": "none",
            "changed": true
          }
        ]
      }
    },
    {
      "name": "a change to existing overrides rewrites only the record",
