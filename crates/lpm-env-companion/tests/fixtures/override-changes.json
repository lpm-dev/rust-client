    {
      "name": "a rename merges the overrides into what the new name has, the moved ones winning",
      "vaultId": "proj",
      "marker": "{\"schemaVersion\":1,\"vaultId\":\"proj\",\"state\":\"active\",\"features\":{\"overrides\":{\"version\":2,\"ifUnsupported\":\"refuse\",\"kinds\":[\"overrides\"],\"state\":\"active\"}}}",
      "record": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"stage\":{\"set\":{\"A\":\"1\",\"B\":\"2\"},\"unset\":[\"C\"]},\"staging\":{\"set\":{\"A\":\"old\",\"OWN\":\"x\"},\"unset\":[]}}}",
      "names": null,
      "edits": [
        {
          "action": "environmentRenamed",
          "from": "stage",
          "to": "staging"
        }
      ],
      "expect": {
        "result": "planned",
        "writes": {
          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"staging\":{\"set\":{\"A\":\"1\",\"B\":\"2\",\"OWN\":\"x\"},\"unset\":[\"C\"]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": false,
        "effects": [
          {
            "kind": "moved",
            "from": "stage",
            "to": "staging",
            "moved": 3,
            "replaced": 1,
            "kept": 1
          }
        ]
      }
    },
    {
      "name": "only removing an environment removes its overrides; a duplicate or a new one changes none",
      "vaultId": "proj",
      "marker": "{\"schemaVersion\":1,\"vaultId\":\"proj\",\"state\":\"active\",\"features\":{\"overrides\":{\"version\":2,\"ifUnsupported\":\"refuse\",\"kinds\":[\"overrides\"],\"state\":\"active\"}}}",
      "record": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"stage\":{\"set\":{\"A\":\"1\",\"B\":\"2\"},\"unset\":[\"C\"]},\"staging\":{\"set\":{\"OLD\":\"x\"},\"unset\":[]}}}",
      "names": null,
      "edits": [
        {
          "action": "environmentDuplicated",
          "from": "stage",
          "to": "staging"
        },
        {
          "action": "environmentCreated",
          "environment": "qa"
        },
        {
          "action": "environmentRemoved",
          "environment": "staging"
        }
      ],
      "expect": {
        "result": "planned",
        "writes": {
          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"stage\":{\"set\":{\"A\":\"1\",\"B\":\"2\"},\"unset\":[\"C\"]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": false,
        "effects": [
          {
            "kind": "notCopied",
            "from": "stage",
            "to": "staging",
            "count": 3,
            "existing": 1
          },
          {
            "kind": "existing",
            "environment": "qa",
            "count": 0
          },
          {
            "kind": "environmentRemoved",
            "environment": "staging",
            "removed": 1
          }
        ]
      }
    },
    {
      "name": "environments changed together swap, chain and go, each keeping its own overrides",
      "vaultId": "proj",
      "marker": "{\"schemaVersion\":1,\"vaultId\":\"proj\",\"state\":\"active\",\"features\":{\"overrides\":{\"version\":2,\"ifUnsupported\":\"refuse\",\"kinds\":[\"overrides\"],\"state\":\"active\"}}}",
      "record": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"a\":{\"set\":{\"K\":\"1\"},\"unset\":[]},\"b\":{\"set\":{\"K\":\"2\"},\"unset\":[]},\"c\":{\"set\":{\"L\":\"3\"},\"unset\":[]},\"gone\":{\"set\":{\"M\":\"4\"},\"unset\":[]}}}",
      "names": null,
      "edits": [
        {
          "action": "environmentsChanged",
          "renamed": [
            {
              "from": "a",
              "to": "b"
            },
            {
              "from": "b",
              "to": "a"
            },
            {
              "from": "c",
              "to": "d"
            }
          ],
          "removed": [
            "gone"
          ]
        }
      ],
      "expect": {
        "result": "planned",
        "writes": {
          "__vault_companion_v1__:overrides:cHJvag": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"a\":{\"set\":{\"K\":\"2\"},\"unset\":[]},\"b\":{\"set\":{\"K\":\"1\"},\"unset\":[]},\"d\":{\"set\":{\"L\":\"3\"},\"unset\":[]}}}"
        },
        "deletes": [],
        "markerAfter": "present",
        "activated": false,
        "effects": [
          {
            "kind": "environmentsChanged",
            "moved": [
              {
                "from": "a",
                "to": "b",
                "moved": 1,
                "replaced": 0,
                "kept": 0
              },
              {
                "from": "b",
                "to": "a",
                "moved": 1,
                "replaced": 0,
                "kept": 0
              },
              {
                "from": "c",
                "to": "d",
                "moved": 1,
                "replaced": 0,
                "kept": 0
              }
            ],
            "removed": [
              {
                "environment": "gone",
                "removed": 1
              }
            ]
          }
        ]
      }
    },
