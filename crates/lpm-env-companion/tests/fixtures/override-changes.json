        "result": "refused",
        "code": "overrides.damaged"
      }
    },
    {
      "name": "a record no marker lists refuses every change",
      "vaultId": "proj",
      "marker": null,
      "record": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"development\":{\"set\":{\"API_URL\":\"http://localhost:4000\"},\"unset\":[]}}}",
      "names": null,
      "edits": [
        {
          "action": "set",
          "environment": "development",
          "key": "A",
          "value": "1"
        }
      ],
      "expect": {
        "result": "refused",
        "code": "overrides.damaged"
      }
    },
    {
      "name": "a newer overrides version refuses changes",
      "vaultId": "proj",
      "marker": "{\"schemaVersion\":1,\"vaultId\":\"proj\",\"state\":\"active\",\"features\":{\"overrides\":{\"version\":3,\"ifUnsupported\":\"refuse\",\"kinds\":[\"overrides\"],\"state\":\"active\"}}}",
      "record": "{\"schemaVersion\":2,\"vaultId\":\"proj\",\"environments\":{\"development\":{\"set\":{\"API_URL\":\"http://localhost:4000\"},\"unset\":[]}}}",
      "names": null,
      "edits": [
        {
          "action": "set",
          "environment": "development",
          "key": "A",
          "value": "1"
        }
      ],
      "expect": {
        "result": "refused",
        "code": "overrides.unsupported"
      }
    },
    {
      "name": "a project without values removes nothing and says so",
      "vaultId": "proj",
      "hasValues": false,
      "marker": null,
      "record": null,
      "names": null,
      "edits": [
        {
          "action": "remove",
          "environment": "development",
          "key": "API_URL"
        },
        {
          "action": "clearAll"
        }
      ],
      "expect": {
        "result": "unchanged",
        "effects": [
          {
            "kind": "key",
            "environment": "development",
            "key": "API_URL",
            "previous": "none",
            "changed": false
          },
          {
            "kind": "cleared",
            "environment": null,
            "removed": 0
          }
        ]
      }
    },
    {
      "name": "a project without values can't have overrides",
      "vaultId": "proj",
      "hasValues": false,
      "marker": null,
      "record": null,
      "names": null,
      "edits": [
        {
          "action": "set",
          "environment": "development",
          "key": "API_URL",
          "value": "http://localhost:4000"
        }
      ],
      "expect": {
        "result": "refused",
        "code": "overrides.no_values"
      }
    }
  ]
}
